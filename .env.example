APP_NAME="Etoko"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=etoko
DB_USERNAME=etoko
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Midtrans Core API lewat SDK resmi midtrans/midtrans-php (P2-E1-T5, ADR-053).
# Kunci dari Settings > Access Keys di dashboard.
# Tanpa MIDTRANS_SERVER_KEY, MidtransGateway menolak charge dengan satu kalimat
# dan metode midtrans-* tetap nonaktif, jadi checkout tidak pernah menawarkannya.
# Tidak ada webhook: status pembayaran ditanyakan ke Status API (halaman pesanan
# + job terjadwal), jadi tidak ada Notification URL yang perlu diisi di dashboard.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_PRODUCTION=false
# MIDTRANS_TIMEOUT=15
# Acquirer QRIS milik akun Midtrans Anda: "gopay" (bawaan) atau "airpay shopee".
# Akun yang QRIS GoPay-nya belum aktif menjawab "Merchant pop id is not found".
# MIDTRANS_QRIS_ACQUIRER=gopay

# Biteship (P2-E2-T6) — test dan live dibedakan oleh key, bukan URL.
BITESHIP_API_KEY=
# BITESHIP_BASE_URL=https://api.biteship.com
# BITESHIP_TIMEOUT=15

# Batas waktu bayar = lama hold stok (ADR-041). Satu angka, sengaja.
# Bawaan 1440 menit = 1 hari (ADR-054).
# SHOP_RESERVATION_MINUTES=1440
