APP_NAME="Etoko"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Host panel staf /admin & /branch (ADR-063/074). Kosong = satu host.
# Dev: admin.localhost (panel di http://admin.localhost:8000, port ikut APP_URL).
# Produksi: mis. admin.etoko.id. Storefront hanya di host APP_URL, panel hanya di host ini.
# Biarkan SESSION_DOMAIN=null agar sesi toko & sesi panel terpisah.
ADMIN_DOMAIN=

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=etoko
DB_USERNAME=etoko
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Queue & cache di Redis (P2-E6-T5, ADR-061). Klien phpredis = ekstensi PHP
# `redis`; tanpa ekstensi itu, ganti kembali ke `database` untuk keduanya.
# Queue memakai database Redis 0, cache database 1 (REDIS_CACHE_DB), sehingga
# `cache:clear` tidak menghapus antrean.
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Midtrans Core API lewat SDK resmi midtrans/midtrans-php (P2-E1-T5, ADR-053).
# Kunci dari Settings > Access Keys di dashboard.
# Tanpa MIDTRANS_SERVER_KEY, MidtransGateway menolak charge dengan satu kalimat
# dan metode midtrans-* tetap nonaktif, jadi checkout tidak pernah menawarkannya.
# Tidak ada webhook: status pembayaran ditanyakan ke Status API (halaman pesanan
# + job terjadwal), jadi tidak ada Notification URL yang perlu diisi di dashboard.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_PRODUCTION=false
# MIDTRANS_TIMEOUT=15
# Acquirer QRIS. Bawaannya mengikuti MIDTRANS_PRODUCTION: "gopay" di produksi
# (harus diaktifkan di dashboard), "airpay shopee" di sandbox — sandbox tidak
# punya pengaturan metode dan menolak gopay ("Merchant pop id is not found").
# Isi hanya bila akun Anda berbeda dari itu.
# MIDTRANS_QRIS_ACQUIRER=

# Biteship (P2-E2-T6) — test dan live dibedakan oleh key, bukan URL.
BITESHIP_API_KEY=
# BITESHIP_BASE_URL=https://api.biteship.com
# BITESHIP_TIMEOUT=15

# Batas waktu bayar = lama hold stok (ADR-041). Satu angka, sengaja.
# Bawaan 1440 menit = 1 hari (ADR-054).
# SHOP_RESERVATION_MINUTES=1440
